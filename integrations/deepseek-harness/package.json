{
  "name": "@agentloopgate/dsh-plugin",
  "version": "0.1.0",
  "description": "AgentLoopGate governance bridge and trace observer for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./provider": {
      "types": "./lib/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./observer": {
      "types": "./lib/observer.d.ts",
      "default": "./lib/observer.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./tau3-runner": {
      "types": "./lib/tau3-runner.d.ts",
      "default": "./lib/tau3-runner.js"
    },
    "./bridge.schema.json": "./src/generated/bridge.schema.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/generated/bridge.schema.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate:protocol": "PYTHONPATH=../.. uv run --project ../.. python -m agentloopgate.cli bridge export-schema --output src/generated",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:conformance": "node test/headless-conformance.mjs",
    "ablation:plugin": "pnpm run build && node test/plugin-overhead.mjs",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.8",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence-sqlite": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-telemetry-otel": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.8",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence-sqlite": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-telemetry-otel": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.8",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
